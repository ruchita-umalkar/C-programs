//  Program to demonstrate params keyword 
using System;
class Program
{
    static void Main()
    {
        Console.WriteLine("Sum of 5 and 10 is: " + Add(5, 10));
        Console.WriteLine("Sum of 5, 10, and 15 is: " + Add(5, 10, 15));
    }

    static int Add(params int[] numbers)
    {
        int sum = 0;
        foreach (int n in numbers)
        {
            sum += n;
        }
        return sum;
    }
}
