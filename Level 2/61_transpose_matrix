//  Program to find transpose of matrix 
using System;
class Program
{
    static void Main()
    {
        int[,] matrix = { { 1, 2, 3 }, { 4, 5, 6 } };
        int[,] transpose = new int[3, 2];

        for (int i = 0; i < 2; i++)
        {
            for (int j = 0; j < 3; j++)
            {
                transpose[j, i] = matrix[i, j];
            }
        }

        Console.WriteLine("Transpose of the matrix:");
        for (int i = 0; i < 3; i++)
        {
            for (int j = 0; j < 2; j++)
            {
                Console.Write(transpose[i, j] + " ");
            }
            Console.WriteLine();
        }
    }
}
