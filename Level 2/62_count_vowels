//  Program to count vowels in a string 
using System;
class Program
{
    static void Main()
    {
        string str = "Hello, World!";
        int count = 0;
        foreach (char c in str)
        {
            if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U')
            {
                count++;
            }
        }
        Console.WriteLine("Number of vowels in the string: " + count);
    }
}
