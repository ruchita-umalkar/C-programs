//  Program to count words in a string 
using System;
class Program
{
    static void Main()
    {
        string str = "Hello, World!";
        int count = 0;
        bool isWord = false;
        foreach (char c in str)
        {
            if (c == ' ' || c == '\t' || c == '\n')
            {
                if (isWord)
                {
                    count++;
                    isWord = false;
                }
            }
            else
            {
                isWord = true;
            }
        }
        if (isWord)
        {
            count++;
        }
        Console.WriteLine("Number of words in the string: " + count);
    }
}
