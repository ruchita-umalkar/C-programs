//  Program to generate Fibonacci using recursion 
using System;
class Program
{
    static void Main()
    {
        int n = 10;
        Console.WriteLine("Fibonacci of {0} is: {1}", n, Fibonacci(n));
    }

    static int Fibonacci(int n)
    {
        if (n == 0)
            return 0;
        else if (n == 1)
            return 1;
        else
            return Fibonacci(n - 1) + Fibonacci(n - 2);
    }
}
