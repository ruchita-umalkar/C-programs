//  Program to demonstrate methods with parameters 
using System;
class Program
{
    static void Main()
    {
        int a = 5;
        int b = 10;
        int sum = Add(a, b);
        Console.WriteLine("Sum of {0} and {1} is {2}", a, b, sum);
    }

    static int Add(int x, int y)
    {
        return x + y;
    }
}
