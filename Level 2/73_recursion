//Program to demonstrate recursion 
using System;
class Program
{
    static void Main()
    {
        int n = 5;
        Console.WriteLine("Factorial of {0} is: {1}", n, Factorial(n));
    }

    static int Factorial(int n)
    {
        if (n == 0)
            return 1;
        else
            return n * Factorial(n - 1);
    }
}
