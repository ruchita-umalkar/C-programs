//  Program to demonstrate passing array to method 
using System;
class Program
{
    static void Main()
    {
        int[] numbers = { 5, 10, 15, 20 };
        Console.WriteLine("Sum of array elements is: " + SumArray(numbers));
    }

    static int SumArray(int[] arr)
    {
        int sum = 0;
        foreach (int n in arr)
        {
            sum += n;
        }
        return sum;
    }
}
