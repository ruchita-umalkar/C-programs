// Program to demonstrate optional parameters 
using System;
class Program
{
    static void Main()
    {
        Console.WriteLine("Result 1: " + Calculate(5, 10));
        Console.WriteLine("Result 2: " + Calculate(5, 10, 15));
    }

    static int Calculate(int x, int y, int z = 0)
    {
        return x + y + z;
    }
}
